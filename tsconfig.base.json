{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Language and module system: modern ESM, resolved the way Vite/Electron bundlers do.
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,

    // Strictness required by AGENTS.md section 9.1.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Additional safety nets.
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,

    // Every file must be compilable in isolation (Vite, esbuild, Node type stripping).
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    // No ambient types unless a package opts in explicitly (keeps `core` free of DOM and Node).
    "types": [],

    // Project references: only declarations are emitted, used for incremental cross-package checks.
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true
  }
}
