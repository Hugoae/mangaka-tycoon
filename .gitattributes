# Normalize line endings: LF in the repository and in the working tree,
# so Prettier, ESLint and save-file fixtures behave identically on Windows, macOS and Linux CI.
* text=auto eol=lf

# Binary assets must never be touched by line-ending conversion.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ogg binary
*.wav binary
*.mp3 binary
