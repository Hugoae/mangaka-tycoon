{
  "name": "mangaka-tycoon",
  "version": "0.0.0",
  "private": true,
  "description": "Mangaka Tycoon: a management game about building a manga career.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "dev": "pnpm --filter @mangaka/game dev",
    "build": "pnpm --filter @mangaka/game build",
    "start": "pnpm --filter @mangaka/game start",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml,css}": "prettier --write"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.28.6 <12"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
